{
  "manifest_version": 3,
  "name": "Read Aloud (Fish Audio)",
  "version": "1.0.0",
  "description": "Highlight text on any page and hear it read aloud using Fish Audio's text-to-speech API.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://api.fish.audio/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
